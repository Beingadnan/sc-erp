{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@school-erp/api && mkdir -p apps/api/public",
  "outputDirectory": "public",
  "regions": ["bom1"],
  "functions": {
    "api/index.mjs": { "maxDuration": 30, "includeFiles": "dist/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
