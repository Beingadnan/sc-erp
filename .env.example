# Copy to .env and fill in. Never commit .env. Never paste these values into chat or tickets.
#
# Neon gives you two connection strings per role:
#   - "direct"  (host has no -pooler)  -> use for migrations and admin scripts
#   - "pooled"  (host contains -pooler) -> use for the running app (PgBouncer, transaction mode)
#
# Roles:
#   erp_owner -> Neon's project owner role (neondb_owner by default). Runs migrations ONLY.
#   erp_app   -> created by `pnpm db:setup-app-role`. NOBYPASSRLS. Used by api + worker.

NODE_ENV=development

# Owner role, DIRECT connection (migrations, setup scripts)
DATABASE_URL_OWNER=postgresql://neondb_owner:CHANGE_ME@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# App role, POOLED connection (api, worker)
DATABASE_URL_APP=postgresql://erp_app:CHANGE_ME@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Password that `pnpm db:setup-app-role` assigns to erp_app (min 16 chars, letters+digits).
ERP_APP_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Redis for BullMQ (local docker-compose by default)
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (used in emailed links)
APP_URL=http://localhost:3000
# Encrypts two-step verification secrets. Generate: openssl rand -base64 32
MFA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
# Require two-step verification for settings/roles/staff changes (default: on in production)
# MFA_ENFORCEMENT=off
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=8
# Reverse proxies in front of the API (0 locally; 1 behind a load balancer)
TRUST_PROXY_HOPS=0

# Web: the Next.js server proxies /api/* to this address
API_URL=http://localhost:4000

# ---- Document storage (Phase 4b) -------------------------------------------------
# Production: create a PRIVATE Vercel Blob store in the Mumbai region (bom1) and paste its
# read-write token. Without a token, files are kept on this machine in LOCAL_STORAGE_DIR
# (development only; the API refuses to start that way in production).
# BLOB_READ_WRITE_TOKEN=
# STORAGE_DRIVER=vercel-blob
# LOCAL_STORAGE_DIR=.storage
